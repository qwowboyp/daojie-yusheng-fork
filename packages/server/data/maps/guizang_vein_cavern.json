  "landmarks": [
    {
      "id": "lm_guizang_return_gate",
      "name": "歸藏回渡口",
      "x": 60,
      "y": 32,
      "desc": "五行深處的入口全被壓進這一小截外口，背後的回渡陣還能把人送回棲真渡，但門前的斷崖已經把直路掐成了折口。"
    },
    {
      "id": "lm_guizang_reflux_corridor",
      "name": "亂流甬道",
      "x": 48,
      "y": 13,
      "desc": "從外口往裡第一段就是細長混脈甬道，金刃、木結、冷流和熔點輪番貼臉，想穩著推進只能一段一段換氣。"
    },
    {
      "id": "lm_guizang_outer_ring",
      "name": "偏脈外環",
      "x": 42,
      "y": 18,
      "desc": "第一圈完整大環路就在這裡開始成形。每一段看似有主屬性，實際上都被別的偏炁從側風擰進來，走久了會發現沒有一塊地是真正單行的。"
    },
    {
      "id": "lm_guizang_bent_gallery",
      "name": "錯流折廊",
      "x": 34,
      "y": 24,
      "desc": "外環之後不再給你直切心區的路，折廊每一次轉向都像被別的炁硬生生橫插一刀，方向感和節奏感都會在這裡被打碎。"
    },
    {
      "id": "lm_guizang_heart_court",
      "name": "歸藏心庭",
      "x": 25,
      "y": 30,
      "desc": "中層第一次稍微放開的平臺，卻不是給人喘氣的地方。五炁殘流在這裡彼此頂撞，站位稍亂就會被不同偏壓輪著撕。"
    },
    {
      "id": "lm_guizang_pressure_steps",
      "name": "壓基前階",
      "x": 21,
      "y": 40,
      "desc": "再往裡走，能站人的線已經越來越像舊陣留下來的邊骨。到這一步，整張圖不再是洞窟，而像一座快要塌掉的立基場。"
    },
    {
      "id": "lm_guizang_core",
      "name": "壓基古陣核",
      "x": 30,
      "y": 31,
      "desc": "陣核沒有大殿，只有一塊還在硬壓五炁的歪陣面。能走到這裡，碰上的就不是哪一行的盡頭，而是練氣期對混行承壓的最終考題。"
    },
    {
      "id": "lm_guizang_heaven_ladder_gate",
      "name": "天梯接引階",
      "x": 32,
      "y": 31,
      "desc": "道基古陣旁的石階只露出最下幾級，真正的長階被道壓藏在陣後。半步築基者可由此踏上天梯。"
    }
  ],
  "npcs": [
    {
