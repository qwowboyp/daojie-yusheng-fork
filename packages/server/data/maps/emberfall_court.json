  "landmarks": [
    {
      "id": "lm_ember_return_steps",
      "name": "回渡火階",
      "x": 28,
      "y": 3,
      "desc": "赤隕庭最上層還算穩的落腳口，往後一步就是棲真渡，往前一步就是整座古爐的下沉火路。"
    },
    {
      "id": "lm_ember_outer_court",
      "name": "焦土外庭",
      "x": 22,
      "y": 9,
      "desc": "最外圈的灰地和斷坡還留著些退路，但熱浪已經開始順著坑壁往裡卷，站久了就會明白這裡不是普通荒地。"
    },
    {
      "id": "lm_ember_heat_terrace",
      "name": "斷層熱堤",
      "x": 41,
      "y": 17,
      "desc": "第一層真正貼著熔裂帶走的臺路，旁邊就是沒熄乾淨的火脈，整條線既窄又躁。"
    },
    {
      "id": "lm_ember_turn_corridor",
      "name": "隕火迴廊",
      "x": 24,
      "y": 22,
      "desc": "路線從這裡開始明顯回折，隕火殘塊和斷牆把視線切碎，逼著人一邊躲火一邊貼路推進。"
    },
    {
      "id": "lm_ember_cracked_gallery",
      "name": "熔裂長廊",
      "x": 28,
      "y": 30,
      "desc": "長廊四周全是翻著熱光的裂帶，再往裡走，已經沒有“外庭”這種說法，只剩古爐本身的壓力。"
    },
    {
      "id": "lm_ember_inner_yard",
      "name": "爐渣內院",
      "x": 24,
      "y": 39,
      "desc": "這裡原本像是守爐人的內院，如今只剩爐渣、焦牆和沒冷透的灰帶，越靜反而越像火還在下面喘。"
    },
    {
      "id": "lm_ember_guizang_gap",
      "name": "歸藏爐隙",
      "x": 40,
      "y": 42,
      "desc": "爐壁最深處裂開了一道向下的舊隙，熱氣沿著縫往更深處倒灌，穿過去就是歸藏脈窟外圍。"
    }
  ],
