  "landmarks": [
    {
      "id": "lm_frostblade_entry",
      "name": "裂谷入口",
      "x": 19,
      "y": 5,
      "desc": "從雲墟臺南崖裂口墜下的第一塊開闊臺地。冰壁向四周陡然張開，寒氣從下方深淵翻湧而上，遠處主道沿著東壁蜿蜒下墜。"
    },
    {
      "id": "lm_frostblade_iron_wall",
      "name": "鐵壁礦脈",
      "x": 27,
      "y": 22,
      "desc": "中層東壁裸露的玄鐵礦脈，礦石帶從崖體中突出，寒鐵碎散落脈根。寒鐵蠍與霜鱗蛇繞脈巡弋。"
    },
    {
      "id": "lm_frostblade_side_cave",
      "name": "寒鐵側洞",
      "x": 32,
      "y": 26,
      "desc": "中層東壁開裂出的窄入口，內部空間被千年寒氣養出一片靈石礦區，傳聞有鐵殼精英妖獸鎮守。"
    },
    {
      "id": "lm_frostblade_ice_bridge",
      "name": "冰橋",
      "x": 19,
      "y": 38,
      "desc": "橫跨深淵裂縫的窄冰橋，僅兩步寬。橋下空冥幽深，橋面玄冰覆蓋一層薄霜，過橋即入淵底冰窟。"
    },
    {
      "id": "lm_frostblade_deep_cavern",
      "name": "冰窟深處",
      "x": 19,
      "y": 50,
      "desc": "霜刃淵最深處的開闊冰窟，寒沼遍地，冰柱林立。鐵殼玄龜與冰晶蛛在沼氣中盤踞，西南壁裂縫透出灼熱氣息。"
    }
  ],
  "npcs": [
    {
      "id": "npc_frostblade_scout",
      "name": "探淵斥候·寒七",
      "x": 17,
      "y": 7,
      "char": "斥",
      "color": "#8bb8cf",
      "dialogue": "淵裡的妖獸都帶金水雙行靈力，皮糙肉厚還會凍人。外圍的寒鐵蠍、霜鱗蛇還好對付；鐵脈甬道里多留意東壁礦脈，那一段路最容易被夾擊。下到冰橋再往深處走，寒沼會拖慢你的腳步——鐵殼玄龜那殼子，築基前期的術法打上去跟撓癢似的。",
      "role": "warning",
      "shopItems": [],
      "quests": []
    }
  ],
